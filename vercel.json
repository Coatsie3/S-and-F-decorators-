{
  "framework": null,
  "installCommand": "echo skip install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/gallery/:path*", "destination": "/projects", "permanent": true },
    { "source": "/gallery", "destination": "/projects", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(services|projects|about|contact)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
